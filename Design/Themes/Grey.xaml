<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- BRAND COLOURS -->
    <SolidColorBrush x:Key="PrimaryColour">#009900</SolidColorBrush>
    <SolidColorBrush x:Key="PrimaryButton">#009900</SolidColorBrush>
    <SolidColorBrush x:Key="PrimaryButtonText">#FFFFFF</SolidColorBrush>
    <SolidColorBrush x:Key="HOVERPrimaryColour">#00B200</SolidColorBrush>
    <SolidColorBrush x:Key="SecondaryColour">#00A4FF</SolidColorBrush>

    <!-- Text -->
    <SolidColorBrush x:Key="UIForeground">#000000</SolidColorBrush>
    <SolidColorBrush x:Key="LinkForeground">#009900</SolidColorBrush>
    <SolidColorBrush x:Key="SplashForeground">#000000</SolidColorBrush>
    <SolidColorBrush x:Key="AuthLettermarkForeground">#000000</SolidColorBrush>

    <!-- Menu -->
    <SolidColorBrush x:Key="MainArea">#FFFFFF</SolidColorBrush>
    <SolidColorBrush x:Key="PANEL">#DED9E0</SolidColorBrush>
    <SolidColorBrush x:Key="PANELForeground">#000000</SolidColorBrush>
    <SolidColorBrush x:Key="PANELOutline">Transparent</SolidColorBrush>
    <SolidColorBrush x:Key="PANELSupportButtonHOVEREDBackground">#AAAAAA</SolidColorBrush>
    <SolidColorBrush x:Key="PANELSupportButtonPRESSED">#DAE0D7</SolidColorBrush>
    <SolidColorBrush x:Key="SELECTEDMainMenuItem">#009900</SolidColorBrush>
    <SolidColorBrush x:Key="SELECTEDMainMenuItemText">#FFFFFF</SolidColorBrush>
    <SolidColorBrush x:Key="HOVERMainMenuItem">#00B200</SolidColorBrush>
    <SolidColorBrush x:Key="MainMenuItem">#000000</SolidColorBrush>
    <SolidColorBrush x:Key="SELECTEDSubMenuItem">#018A01</SolidColorBrush>
    <SolidColorBrush x:Key="subMenuItem">#EAF1E7</SolidColorBrush>
    <SolidColorBrush x:Key="SubMenuForeground">#000000</SolidColorBrush>
    <SolidColorBrush x:Key="HOVERSubMenuItem">#656565</SolidColorBrush>

    <!-- List -->
    <SolidColorBrush x:Key="SELECTEDListItem">#C5CCC4</SolidColorBrush>
    <SolidColorBrush x:Key="ListItem">#EAF1E7</SolidColorBrush>

    <!-- Time Edit -->
    <SolidColorBrush x:Key="TimeEdit">#E0E0E0</SolidColorBrush>

    <!-- Calendar -->
    <SolidColorBrush x:Key="CalendarBackground" Color="#A0A0A0"/>

    <!-- TOOLBAR-->
    <SolidColorBrush x:Key="TOOLBAR">#DAE0D7</SolidColorBrush>
    <SolidColorBrush x:Key="ToolbarItem">#656565</SolidColorBrush>
    <SolidColorBrush x:Key="SELECTEDToolbutton">#F3FAF0</SolidColorBrush>
</ResourceDictionary>